---
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import { href } from '../utils/path';
import { nav, header, company } from '../data/content';

const basePath = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const path = Astro.url.pathname.replace(basePath, '').replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href={href('/')} aria-label={`${company.name} — Beranda`}>
      <BrandLogo compact />
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Navigasi utama">
      {nav.map((link) => (
        <a
          href={href(link.href)}
          class:list={[{ active: isActive(link.href) }, { 'nav-temp': 'newTab' in link && link.newTab }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
          target={'newTab' in link && link.newTab ? '_blank' : undefined}
          rel={'newTab' in link && link.newTab ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a href={href('/contact')} class="btn btn-primary btn-sm header-cta">
      {header.ctaLabel} <Icon name="arrow" />
    </a>

    <button class="menu-toggle" id="menu-toggle" type="button" aria-label={header.menuLabel} aria-expanded="false" aria-controls="site-nav">
      <Icon name="menu" />
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
