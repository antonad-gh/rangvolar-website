---
import { href } from '../utils/path';
import { company } from '../data/content';

interface Props {
  compact?: boolean;
  variant?: 'transparent' | 'white';
}

const { compact = false, variant = 'transparent' } = Astro.props;
const src = variant === 'white' ? '/images/logo-white.png' : '/images/logo-transparent.png';
---

<span class:list={['brand', { 'brand-compact': compact }]}>
  <img src={href(src)} alt={company.name} width="464" height="82" />
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    line-height: 0;
  }

  .brand img {
    display: block;
    width: 214px;
    height: auto;
  }

  .brand-compact img { width: 196px; }

  @media (max-width: 640px) {
    .brand img { width: 180px; }
    .brand-compact img { width: 168px; }
  }
</style>
