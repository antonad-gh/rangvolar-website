---
import BrandLogo from './BrandLogo.astro';
import { href } from '../utils/path';
import { nav, company, footerContent } from '../data/content';

const year = new Date().getFullYear();
const { contact } = company;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href={href('/')} aria-label={`${company.name} — Beranda`}>
          <BrandLogo variant="white" />
        </a>
        <p class="footer-about">{footerContent.description}</p>
      </div>

      <div>
        <h5>{footerContent.navHeading}</h5>
        <ul class="footer-links">
          {nav.map((item) => <li><a href={href(item.href)}>{item.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h5>{footerContent.servicesHeading}</h5>
        <ul class="footer-links">
          {footerContent.serviceLinks.map((item) => (
            <li><a href={href(`/services#${item.id}`)}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h5>{footerContent.contactHeading}</h5>
        <div class="footer-contact">
          📍 {contact.address}<br />
          📞 {contact.phone}<br />
          ✉️ {contact.email}<br />
          🕐 {contact.hours}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {company.name} — {footerContent.copyright}</span>
      <span>{company.tagline}</span>
    </div>
  </div>
</footer>
