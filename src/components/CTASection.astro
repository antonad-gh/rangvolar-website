---
import { href } from '../utils/path';
import { defaultCta } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  buttonLabel?: string;
}

const {
  title = defaultCta.titleHtml,
  description = defaultCta.description,
  buttonLabel = defaultCta.button,
} = Astro.props;
---

<section class="section-sm">
  <div class="container">
    <div class="cta-panel">
      <div>
        <h2 set:html={title} />
        <p>{description}</p>
      </div>
      <a href={href('/contact')} class="btn btn-primary">{buttonLabel} &rarr;</a>
    </div>
  </div>
</section>
