---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { about, values } from '../data/content';
import { href } from '../utils/path';

const imageProfile = href('/images/architecture.jpg');
---

<BaseLayout title={about.seoTitle} description={about.seoDescription}>
  <PageHero {...about.hero} />

  <section class="section">
    <div class="container split">
      <div class="split-visual" style={`background-image: url('${imageProfile}')`}></div>
      <div>
        <span class="eyebrow">{about.profile.eyebrow}</span>
        <h2 style="font-size: clamp(28px, 4vw, 38px);">{about.profile.title}</h2>
        <div class="prose" style="margin-top: 20px;">
          {about.profile.paragraphsHtml.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-deep section-grid">
    <div class="container">
      <SectionHeading
        eyebrow={about.visionMission.eyebrow}
        title={about.visionMission.title}
        description={about.visionMission.description}
        center
      />
      <div class="grid-2">
        <article class="card">
          <div class="icon-box"><Icon name="target" /></div>
          <h3>{about.visionMission.visionLabel}</h3>
          <p>{about.visionMission.vision}</p>
        </article>
        <article class="card">
          <div class="icon-box"><Icon name="zap" /></div>
          <h3>{about.visionMission.missionLabel}</h3>
          <p>{about.visionMission.mission}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow={about.values.eyebrow}
        title={about.values.title}
        description={about.values.description}
      />
      <div class="grid-3">
        {values.map((value) => (
          <article class="card value-card">
            <div class="icon-box"><Icon name={value.icon} /></div>
            <h3>{value.title}</h3>
            <p>{value.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
