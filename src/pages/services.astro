---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { services } from '../data/site';

const steps = [
  { title: 'Konsultasi', description: 'Mendiskusikan kebutuhan, kondisi lokasi, dan lingkup pekerjaan yang diinginkan.' },
  { title: 'Perencanaan', description: 'Menyiapkan desain, material, jadwal, dan estimasi biaya sesuai kebutuhan.' },
  { title: 'Pemasangan', description: 'Melaksanakan instalasi lapangan dengan mengutamakan kerapian dan keselamatan.' },
  { title: 'Serah Terima', description: 'Pengujian, dokumentasi as-built, dan pendampingan hingga sistem siap digunakan.' },
];
---

<BaseLayout
  title="Layanan — PT. Rangrang Volar Sinergi"
  description="Layanan pemasangan kabel jaringan, fiber optic, CCTV dan access control, instalasi listrik serta UPS, dan pembangunan data center."
>
  <PageHero
    eyebrow="// LAYANAN KAMI"
    title="Solusi Lengkap untuk Infrastruktur Anda"
    description="Dari sistem kabel terstruktur hingga integrasi data center, kami menangani setiap tahap pengerjaan dengan standar kualitas dan ketepatan waktu."
    current="Services"
  />

  <section class="section">
    <div class="container">
      {services.map((service) => (
        <article class="service-detail" id={service.id}>
          <div class="service-detail-head">
            <div class="icon-box"><Icon name={service.icon} /></div>
            <span class="mono text-accent" style="font-size: 12px;">{service.number} / {service.category}</span>
            <h2>{service.title}</h2>
          </div>
          <div class="service-detail-body">
            <p>{service.description}</p>
            <ul class="check-list">
              {service.points.map((point) => (
                <li><Icon name="check" /> <span>{point}</span></li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-deep section-grid">
    <div class="container">
      <SectionHeading
        eyebrow="// ALUR KERJA"
        title="Proses Pengerjaan yang Terarah"
        description="Setiap proyek kami jalani melalui tahapan yang jelas agar hasil sesuai dengan harapan."
        center
      />
      <div class="steps">
        {steps.map((step) => (
          <div class="step">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title='Diskusikan Kebutuhan <span class="accent">Layanan Anda</span>'
    description="Kami siap membantu menentukan solusi yang paling sesuai dengan kebutuhan dan kondisi lapangan Anda."
    buttonLabel="Minta Penawaran"
  />
</BaseLayout>

<style>
  .service-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding-block: 44px;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 90px;
  }

  .service-detail:first-child {
    padding-top: 0;
  }

  .service-detail:last-child {
    border-bottom: 0;
  }

  .service-detail-head h2 {
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1.3;
    margin-top: 14px;
    max-width: 520px;
  }

  .service-detail-body > p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.9;
  }

  @media (max-width: 860px) {
    .service-detail {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-block: 36px;
    }
  }
</style>
