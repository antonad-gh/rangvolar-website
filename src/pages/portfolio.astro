---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { portfolioPage, projects } from '../data/content';
---

<BaseLayout title={portfolioPage.seoTitle} description={portfolioPage.seoDescription}>
  <PageHero {...portfolioPage.hero} />

  <section class="section">
    <div class="container">
      <SectionHeading {...portfolioPage.intro} />
      <div class="work-grid">
        {projects.map((project) => (
          <article class="work-item">
            <div class="work-img" style={`background-image: url('${project.image}')`}>
              <span class="work-badge">{project.category}</span>
            </div>
            <div class="work-meta">
              <small>{project.year}</small>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title={portfolioPage.cta.titleHtml}
    description={portfolioPage.cta.description}
    buttonLabel={portfolioPage.cta.button}
  />
</BaseLayout>
