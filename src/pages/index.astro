---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatBand from '../components/StatBand.astro';
import CTASection from '../components/CTASection.astro';
import { services, projects } from '../data/site';
import { href } from '../utils/path';

const ticker = [
  'STRUCTURED CABLING',
  'FIBER OPTIC',
  'CCTV & ACCESS CONTROL',
  'INSTALASI LISTRIK & UPS',
  'DATA CENTER',
];

const imageAbout = href('/images/network-cables.jpg');
const heroStyle = `background-image: url('${href('/images/data-center.jpg')}')`;
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero" style={heroStyle}>
    <div class="container">
      <div class="hero-copy">
        <span class="eyebrow">&gt; INFRASTRUCTURE.SECURITY.DATACENTER</span>
        <h1>Membangun <span class="accent">Infrastruktur Digital</span> Anda</h1>
        <p class="hero-lead">
          PT. Rangrang Volar Sinergi menghadirkan solusi pembangunan dan pemasangan infrastruktur jaringan komputer,
          fiber optic, sistem keamanan, hingga data center yang kokoh, aman, dan siap mendukung operasional bisnis Anda.
        </p>
        <div class="hero-actions">
          <a href={href('/services')} class="btn btn-primary">Lihat Layanan Kami <Icon name="arrow" /></a>
          <a href={href('/contact')} class="btn btn-ghost">Konsultasi Gratis</a>
        </div>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="container ticker-inner">
      {ticker.map((item) => <span>{item}</span>)}
    </div>
  </div>

  <!-- LAYANAN -->
  <section class="section" id="layanan">
    <div class="container">
      <SectionHeading
        eyebrow="// LAYANAN KAMI"
        title="Satu Mitra untuk Semua<br />Kebutuhan Infrastruktur"
        description="Kami menangani setiap tahap pengerjaan — dari perencanaan, instalasi, integrasi, hingga dokumentasi akhir."
      />
      <div class="grid-3">
        {services.map((service) => (
          <ServiceCard
            number={service.number}
            category={service.category}
            icon={service.icon}
            title={service.title}
            description={service.short}
            href={`/services#${service.id}`}
          />
        ))}
      </div>
    </div>
  </section>

  <StatBand />

  <!-- MENGAPA KAMI -->
  <section class="section section-deep">
    <div class="container split">
      <div class="split-visual" style={`background-image: url('${imageAbout}')`}>
        <div class="float-chip">
          <b>100%</b>
          <span>Komitmen pada kualitas<br />setiap pengerjaan</span>
        </div>
      </div>
      <div>
        <span class="eyebrow">// MENGAPA MEMILIH KAMI</span>
        <h2 style="font-size: clamp(28px, 4vw, 38px); line-height: 1.2;">
          Partner yang Andal untuk Setiap Proyek
        </h2>
        <div class="prose" style="margin-top: 18px;">
          <p>
            Didukung oleh <strong>sumber daya manusia yang memadai</strong> dan pengalaman kerja yang luas di lapangan,
            kami memastikan setiap instalasi dikerjakan dengan rapi, aman, dan siap digunakan untuk jangka panjang.
          </p>
        </div>
        <ul class="check-list">
          <li><Icon name="check" /> <span>Tim teknisi berpengalaman di bidang cabling, fiber optic, dan data center</span></li>
          <li><Icon name="check" /> <span>Pengerjaan sesuai standar dan ketepatan waktu yang disepakati</span></li>
          <li><Icon name="check" /> <span>Dokumentasi dan labeling yang rapi untuk kemudahan perawatan</span></li>
          <li><Icon name="check" /> <span>Pendampingan dari perencanaan hingga serah terima proyek</span></li>
        </ul>
        <a href={href('/about')} class="btn btn-outline btn-sm" style="margin-top: 30px;">Kenali Kami Lebih Lanjut <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- PORTOFOLIO PREVIEW -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="// PORTOFOLIO"
        title="Hasil Karya di Lapangan"
        description="Dokumentasi sebagian proyek yang telah kami selesaikan untuk berbagai sektor industri."
        center
      />
      <div class="work-grid">
        {projects.slice(0, 3).map((project) => (
          <article class="work-item">
            <div class="work-img" style={`background-image: url('${project.image}')`}>
              <span class="work-badge">{project.category}</span>
            </div>
            <div class="work-meta">
              <small>{project.year}</small>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div style="text-align: center; margin-top: 34px;">
        <a href={href('/portfolio')} class="btn btn-outline">Lihat Semua Proyek <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
