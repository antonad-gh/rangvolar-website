---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatBand from '../components/StatBand.astro';
import CTASection from '../components/CTASection.astro';
import { home, services, projects } from '../data/content';
import { href } from '../utils/path';

const imageAbout = href('/images/network-cables.jpg');
const heroImage = href('/images/hero-cabling.jpg');
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero" style={`--hero-image: url('${heroImage}')`}>
    <div class="hero-media" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow hero-eyebrow">
          <span class="hero-pulse" aria-hidden="true"></span>
          &gt; {home.hero.eyebrow}
        </span>
        <h1 set:html={home.hero.titleHtml} />
        <p class="hero-lead">{home.hero.description}</p>
        <div class="hero-actions">
          <a href={href('/services')} class="btn btn-primary">{home.hero.ctaPrimary} <Icon name="arrow" /></a>
          <a href={href('/contact')} class="btn btn-ghost">{home.hero.ctaSecondary}</a>
        </div>
      </div>
    </div>

    <div class="hero-scroll" aria-hidden="true">
      <span>SCROLL TO EXPLORE</span>
      <i></i>
    </div>
  </section>

  <!-- TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="container ticker-inner">
      {home.ticker.map((item) => <span>{item}</span>)}
    </div>
  </div>

  <!-- LAYANAN -->
  <section class="section" id="layanan">
    <div class="container">
      <SectionHeading
        eyebrow={home.services.eyebrow}
        title={home.services.titleHtml}
        description={home.services.description}
      />
      <div class="grid-3">
        {services.map((service) => (
          <ServiceCard
            number={service.number}
            category={service.category}
            icon={service.icon}
            title={service.title}
            description={service.short}
            href={`/services#${service.id}`}
          />
        ))}
      </div>
    </div>
  </section>

  <StatBand />

  <!-- MENGAPA KAMI -->
  <section class="section section-deep">
    <div class="container split">
      <div class="split-visual" style={`background-image: url('${imageAbout}')`}>
        <div class="float-chip">
          <b>{home.why.chipValue}</b>
          <span set:html={home.why.chipTextHtml} />
        </div>
      </div>
      <div>
        <span class="eyebrow">{home.why.eyebrow}</span>
        <h2 style="font-size: clamp(28px, 4vw, 38px); line-height: 1.2;">
          {home.why.title}
        </h2>
        <div class="prose" style="margin-top: 18px;">
          <p set:html={home.why.descriptionHtml} />
        </div>
        <ul class="check-list">
          {home.why.points.map((point) => (
            <li><Icon name="check" /> <span>{point}</span></li>
          ))}
        </ul>
        <a href={href('/about')} class="btn btn-outline btn-sm" style="margin-top: 30px;">
          {home.why.cta} <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- PORTOFOLIO PREVIEW -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow={home.portfolio.eyebrow}
        title={home.portfolio.title}
        description={home.portfolio.description}
        center
      />
      <div class="work-grid">
        {projects.slice(0, 3).map((project) => (
          <article class="work-item">
            <div class="work-img" style={`background-image: url('${project.image}')`}>
              <span class="work-badge">{project.category}</span>
            </div>
            <div class="work-meta">
              <small>{project.year}</small>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div style="text-align: center; margin-top: 34px;">
        <a href={href('/portfolio')} class="btn btn-outline">{home.portfolio.cta} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
