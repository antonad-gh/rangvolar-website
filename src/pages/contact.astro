---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { contactPage, services, company } from '../data/content';

const f = contactPage.form.fields;
const { contact } = company;
---

<BaseLayout title={contactPage.seoTitle} description={contactPage.seoDescription}>
  <PageHero {...contactPage.hero} />

  <section class="section">
    <div class="container">
      <div class="contact-layout">
        <div>
          <span class="eyebrow">{contactPage.intro.eyebrow}</span>
          <h2 style="font-size: clamp(26px, 3.5vw, 34px);">{contactPage.intro.title}</h2>
          <p style="color: var(--muted); font-size: 14.5px; line-height: 1.85; margin-top: 14px; max-width: 480px;">
            {contactPage.intro.description}
          </p>

          <div class="info-list" style="margin-top: 28px;">
            <div class="info-item">
              <div class="icon-box"><Icon name="pin" /></div>
              <div>
                <h3>{contactPage.intro.labels.address}</h3>
                <p>{contact.address}</p>
              </div>
            </div>
            <div class="info-item">
              <div class="icon-box"><Icon name="phone" /></div>
              <div>
                <h3>{contactPage.intro.labels.phone}</h3>
                <p>{contact.phone}<br />Fax: {contact.fax}</p>
              </div>
            </div>
            <div class="info-item">
              <div class="icon-box"><Icon name="mail" /></div>
              <div>
                <h3>{contactPage.intro.labels.email}</h3>
                <p>{contact.email}</p>
              </div>
            </div>
            <div class="info-item">
              <div class="icon-box"><Icon name="clock" /></div>
              <div>
                <h3>{contactPage.intro.labels.hours}</h3>
                <p>{contact.hours}<br />{contact.hoursExtra}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="form-card">
          <div class="form-success" id="form-success" role="status">
            {contactPage.form.successMessage}
          </div>
          <form id="contact-form" novalidate>
            <div class="form-row">
              <div class="field">
                <label for="nama">{f.nama.label} <span class="req">*</span></label>
                <input type="text" id="nama" name="nama" placeholder={f.nama.placeholder} required />
                <span class="error">{f.nama.error}</span>
              </div>
              <div class="field">
                <label for="perusahaan">{f.perusahaan.label}</label>
                <input type="text" id="perusahaan" name="perusahaan" placeholder={f.perusahaan.placeholder} />
                <span class="error">{f.perusahaan.error}</span>
              </div>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="email">{f.email.label} <span class="req">*</span></label>
                <input type="email" id="email" name="email" placeholder={f.email.placeholder} required />
                <span class="error">{f.email.error}</span>
              </div>
              <div class="field">
                <label for="telepon">{f.telepon.label} <span class="req">*</span></label>
                <input type="tel" id="telepon" name="telepon" placeholder={f.telepon.placeholder} required />
                <span class="error">{f.telepon.error}</span>
              </div>
            </div>

            <div class="field">
              <label for="layanan">{f.layanan.label} <span class="req">*</span></label>
              <select id="layanan" name="layanan" required>
                <option value="">{f.layanan.placeholder}</option>
                {services.map((service) => <option value={service.id}>{service.title}</option>)}
                <option value="lainnya">{contactPage.form.otherOption}</option>
              </select>
              <span class="error">{f.layanan.error}</span>
            </div>

            <div class="field">
              <label for="pesan">{f.pesan.label} <span class="req">*</span></label>
              <textarea id="pesan" name="pesan" placeholder={f.pesan.placeholder} required></textarea>
              <span class="error">{f.pesan.error}</span>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">
              {contactPage.form.submitLabel} <Icon name="arrow" />
            </button>
            <p class="form-note">{contactPage.form.note}</p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 56px;
    align-items: start;
  }

  @media (max-width: 960px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');

  function validateField(input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) {
    const field = input.closest('.field');
    let valid = true;

    if (input.hasAttribute('required') && !input.value.trim()) {
      valid = false;
    } else if (input.type === 'email' && input.value.trim()) {
      valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim());
    }

    field?.classList.toggle('invalid', !valid);
    return valid;
  }

  form?.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')
    .forEach((input) => {
      input.addEventListener('input', () => validateField(input));
      input.addEventListener('change', () => validateField(input));
      input.addEventListener('blur', () => validateField(input));
    });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    let allValid = true;
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')
      .forEach((input) => {
        if (!validateField(input)) allValid = false;
      });

    if (!allValid) {
      success?.style.setProperty('display', 'none');
      form.querySelector('.invalid input, .invalid select, .invalid textarea')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    /*
     * TODO: Hubungkan ke backend / layanan email sebelum produksi.
     * Contoh: fetch('/api/contact', { method: 'POST', body: new FormData(form) })
     * Untuk situs statis, bisa juga memakai Formspree / Netlify Forms / Web3Forms.
     */
    form.reset();
    if (success) success.style.display = 'block';
    success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>
