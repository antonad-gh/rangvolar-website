---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { teamPage, team } from '../data/content';
import { href } from '../utils/path';
---

<BaseLayout title={teamPage.seoTitle} description={teamPage.seoDescription}>
  <PageHero {...teamPage.hero} />

  <section class="section">
    <div class="container">
      <SectionHeading {...teamPage.intro} />
      <div class="team-grid">
        {team.map((member) => (
          <article class="card team-card">
            <div class="team-avatar">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="32" cy="24" r="11" />
                <path d="M12 58a20 20 0 0 1 40 0" />
              </svg>
            </div>
            <h3>{member.name}</h3>
            <span class="role">{member.role}</span>
            <p>{member.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-deep">
    <div class="container">
      <div class="cta-panel" style="margin: 0;">
        <div>
          <h2>{teamPage.cta.title}</h2>
          <p>{teamPage.cta.description}</p>
        </div>
        <a href={href('/contact')} class="btn btn-primary">{teamPage.cta.button} &rarr;</a>
      </div>
    </div>
  </section>

  <CTASection
    title={teamPage.finalCta.titleHtml}
    description={teamPage.finalCta.description}
    buttonLabel={teamPage.finalCta.button}
  />
</BaseLayout>
